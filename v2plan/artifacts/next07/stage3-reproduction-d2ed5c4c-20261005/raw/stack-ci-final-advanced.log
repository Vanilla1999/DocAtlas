advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632675Z           },
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632719Z           {
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632881Z             "evidence_id": "ev-c2eddc6ad062a61d",
