advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1630923Z           {
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1630991Z             "evidence_id": "ev-38329dc4234fd6be",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1631055Z             "path_or_url": "wiki/Architecture.md",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1631173Z             "section": "Architecture > Project documentation storage and isolation",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632017Z             "snippet": "Project documentation storage is organized as a derived, project-scoped index\nof repository-owned files. Each project identity receives isolated SQLite index\nstate and extracted artifacts, so one repository's project docs cannot satisfy\nanother repository's query. The filesystem documents remain authoritative; the\nindex is a rebuildable cache coordinated by the writer lease and cleanup barrier\ndescribed in [Index cleanup](../docs/index-cleanup.md).",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632084Z             "version_binding": "unversioned",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632226Z             "content_sha256": "c8c735ed372b01120403671017caff692a4201e4863dac96a044591fd2d1b669",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T12:39:36.1632319Z             "project_identity": "git:github.com/Vanilla1999/DocAtlas",
