advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0897759Z           {
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0897816Z             "evidence_id": "ev-38329dc4234fd6be",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0897878Z             "path_or_url": "wiki/Architecture.md",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0897989Z             "section": "Architecture > Project documentation storage and isolation",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0898775Z             "snippet": "Project documentation storage is organized as a derived, project-scoped index\nof repository-owned files. Each project identity receives isolated SQLite index\nstate and extracted artifacts, so one repository's project docs cannot satisfy\nanother repository's query. The filesystem documents remain authoritative; the\nindex is a rebuildable cache coordinated by the writer lease and cleanup barrier\ndescribed in [Index cleanup](../docs/index-cleanup.md).",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0898839Z             "version_binding": "unversioned",
advanced-contract	Run Legacy live compatibility report and lineage floor	2026-10-05T11:33:53.0898968Z             "content_sha256": "c8c735ed372b01120403671017caff692a4201e4863dac96a044591fd2d1b669",
