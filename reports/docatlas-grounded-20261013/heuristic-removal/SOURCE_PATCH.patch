+"""Default-off execution arms for the frozen heuristic-removal experiment.
+
+This switch chooses an implementation, never qualifies a source or an answer.
+Q: acquisition; A: admission; S: selection/assembly; ALL: combination.
+"""
+from __future__ import annotations
+
+import os
+
+
+def heuristic_removal_active(stage: str) -> bool:
+    """Return whether the host selected this removal arm."""
+    arm = os.environ.get("DOCATLAS_EXPERIMENT_HEURISTIC_REMOVAL", "")
+    return stage in {"Q", "A", "S"} and arm in {stage, "ALL"}
