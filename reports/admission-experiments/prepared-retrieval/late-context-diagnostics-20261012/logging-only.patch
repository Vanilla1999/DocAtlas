+                                for row in event["rows"][:MAX_CONTEXT_FLOW_SOURCES]]
+                item["serialization_omitted_source_rows"] = max(0, len(event["rows"]) - MAX_CONTEXT_FLOW_SOURCES)
+        result["events"].append(item)
+    return result
+
