      {
        "evidence_id": "ev-2f3db0741082cf412752f0f4",
        "path_or_url": "architecture.md",
        "section": "Scheduler architecture",
        "snippet": "# Scheduler architecture\n\nMeridian separates ownership, planning, execution and display to permit independent restarts.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "e66900a35be4eed38ef6938daa29048edb6d720950c729b6138d3c845f8e1256",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
        "line_start": 1,
        "line_end": 4,
        "authority": "source_of_truth",
        "scope": "project",
        "source_uri": "docatlas://source/v2/edb96e29e7159af7d5434b4e"
      },
      {
        "evidence_id": "ev-ddcdb385fc85d98235dd30e4",
        "path_or_url": "architecture.md",
        "section": "Scheduler architecture > Prototype recovery",
        "snippet": "## Prototype recovery\n\nThe retired prototype cleared pending reservations when time drifted and restarted on its first local clock sample. These behaviours must not be used to recover the current gateway.\n",
        "version_binding": "unversioned",
        "content_sha256": "09bc1c0bdc301d5f3aceed45131ae2ef72f7d4de26b6703b4aba49c5ed7768d5",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
        "line_start": 9,
        "line_end": 11,
        "authority": "source_of_truth",
        "scope": "project",
        "source_uri": "docatlas://source/v2/64d98adad89ad3996ad96c30"
      },
      {
        "evidence_id": "ev-ce3ca2d7cee09fa904c4b775",
        "path_or_url": "clock.md",
        "section": "Time coordination",
        "snippet": "# Time coordination\n\nThe gateway compares instrument time with the observatory reference before executing a schedule.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "a3f190e7993a469e6119495861d14939bcff7449381f98171007b1df09cf15b5",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
        "line_start": 1,
        "line_end": 4,
        "authority": "source_of_truth",
        "scope": "project",
        "source_uri": "docatlas://source/v2/c33469bec3e8eb954bb726b5"
      },
      {
        "evidence_id": "ev-55c143364bfd336a97fb3c01",
        "path_or_url": "clock.md",
        "section": "Time coordination > Clock offset",
        "snippet": "## Clock offset\n\nIf the absolute clock offset exceeds two seconds, pause schedule execution and notify the duty operator. Keep queued reservations unchanged. Resume only after two consecutive reference checks report an offset within two seconds.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "137e5aa9e32ce98830a0daf3934007e2938ad69194d35d2f1d1561561fec1688",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
        "line_start": 5,
        "line_end": 8,
        "authority": "source_of_truth",
        "scope": "project",
        "source_uri": "docatlas://source/v2/dd3be084de77200ef8264270"
      },
      {
        "evidence_id": "ev-9ac111c5091915eca45488c1",
        "path_or_url": "clock.md",
        "section": "Time coordination > Missing reference",
        "snippet": "## Missing reference\n\nIf the reference clock is unavailable, keep execution paused; a local clock reading alone cannot satisfy either recovery check.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "32824ba94965e122f5e3747db8478a3f474ce0cd56d9277c8f4d8a09daa06a22",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
        "line_start": 9,
        "line_end": 12,
        "authority": "source_of_truth",
        "scope": "project",
        "source_uri": "docatlas://source/v2/5a6f739bce7f79fbef7f2da5"
      },
      {
        "evidence_id": "ev-301f990581a380edf5bcc039",
        "path_or_url": "clock.md",
        "section": "Time coordination > Simulation clock",
        "snippet": "## Simulation clock\n\nThe simulator advances time manually and never waits for reference checks. Its accelerated clock is isolated from the real instrument gateway.\n",
        "version_binding": "unversioned",
        "content_sha256": "06e04acb71841d5b411b0566057e2407c4f4c2cca59d82b59639f1e88f812b97",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
        "line_start": 13,
        "line_end": 15,
        "authority": "source_of_truth",
        "scope": "project",
        "source_uri": "docatlas://source/v2/886db68f981c9a7b0283b30c"
      }
    ],
