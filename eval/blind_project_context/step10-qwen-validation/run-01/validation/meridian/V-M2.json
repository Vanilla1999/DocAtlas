        "path_or_url": "weather.md",
        "section": "Weather decisions",
        "snippet": "# Weather decisions\n\nWeather decisions govern execution, not ownership of reservations.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "47538b49a66e39e7065254d6f23595e323499083e28baa11a03a6f96ed32aaf2",
        "project_identity": "local:ff995e7a5b787e3a6bd0480c8c917249162958c76a73bebfae066060416c4458",
