      "path_or_url": "cave-radio.md",
      "section": "Cave team equipment guide",
      "snippet": "# Cave team equipment guide\n\nThis guide contains separate equipment procedures and storeroom information for the cave survey team. A heading's instructions apply only to the equipment it names.\n\n",
      "version_binding": "unversioned",
      "content_sha256": "e91d8ad238d918f4a31d686967d0d16e2af878be44c07430cdab591b1e2dcb52",
      "project_identity": "local:505e3f3fa9f43844161d99171f979a802340ab7efbe44322b924bf217c225ec5",
      "line_start": 1,
      "line_end": 4,
