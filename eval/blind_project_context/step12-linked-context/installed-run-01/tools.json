                    },
                    "content_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "maxLength": 64
                    },
                    "catalog_entry_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "maxLength": 71
