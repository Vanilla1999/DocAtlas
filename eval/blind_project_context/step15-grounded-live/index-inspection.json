      "url": "https://raw.githubusercontent.com/Vanilla1999/DocAtlas/e62fa9e357bd22731cddabe930532a4a2faecc18/eval/blind_project_context/step14-host-language-live/frozen-corpus/weather",
      "title": "Weather decisions",
      "etag": "W/\"4dd779ecf33a84c32e7567e3aedb1928608c52dde3e3804ad0d2e76d099b660d\"",
      "last_modified": null,
      "content_type": "text/markdown",
      "created_at": "2026-11-08 08:50:43",
