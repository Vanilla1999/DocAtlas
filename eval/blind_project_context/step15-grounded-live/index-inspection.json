      "chunks": [
        {
          "id": 115,
          "content": "# Calendar display\nThe calendar is a read-only projection of reservation and instrument state.\n## Colours\nAmber indicates a pending assignment, blue a confirmed slot, and grey a suspended interval. Changing a browser theme changes colours locally without changing instrument execution. A visual refresh cannot clear a maintenance lock.\n## Timezones\nObservers may display the same reservation in different timezones. The stored start time and reservation identifier remain unchanged. Calendar export is a view, not a gateway command.",
          "metadata": "{\"types\":[\"heading\",\"text\"],\"level\":1,\"path\":[\"Calendar display\",\"Timezones\"]}",
          "sort_order": 0,
          "embedding_bytes": null,
          "sha256": "c129d56039db53ff07d629a7308af65840cd141c653486b9acba3e141c3bf6f3",
          "exact_source_substring": false,
          "source_line_span": null
        }
      ],
