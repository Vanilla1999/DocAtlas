    },
    {
      "evidence_id": "ev-5ae39f0671e525ca0fdd6b23",
      "path_or_url": "relay.md",
      "section": "Relay workshop > Parcel collection",
      "snippet": "## Parcel collection\n\nCourier parcels are collected at the workshop door on Tuesdays. Parcels awaiting collection are placed on the green trolley.\n",
