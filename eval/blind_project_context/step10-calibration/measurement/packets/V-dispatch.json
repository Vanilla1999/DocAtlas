      "evidence_id": "ev-5cfbb17e1f76ab196267cac6",
      "path_or_url": "observatory.md",
      "section": "Observatory archive > Dispatch",
      "snippet": "## Dispatch\n\nDispatch a photographic plate only after its catalogue number has been entered on a padded crate label. The receiving curator must acknowledge the inventory before the crate leaves the archive.\n\n",
      "version_binding": "unversioned",
      "content_sha256": "78566564c187eaa3575211e5868f3b327e2c756c27f3b86aad016dc7d14febde",
      "project_identity": "local:aab9dc703acc3da501b58414194c3a6874093ab30032bc097c0490c78f5a637d",
