    },
    {
      "evidence_id": "ev-9e485a8092bd96f72ea0d85b",
      "path_or_url": "seedbank.md",
      "section": "Alder seed archive > Receiving envelopes > Cabinet furniture",
      "snippet": "### Cabinet furniture\n\nThe cabinet has seven removable shelves. Spare shelf pins are kept in the maintenance locker.\n\n",
      "version_binding": "unversioned",
      "content_sha256": "2bedd312f6a28953560ad3772e3aab33a228438e63fd33b28d15e7f48e55e27d",
