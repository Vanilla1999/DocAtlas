    },
    {
      "evidence_id": "ev-3179ad697bf60941ace26014",
      "path_or_url": "optics.md",
      "section": "Meridian mirror workshop > Packing a mirror",
      "snippet": "## Packing a mirror\n\nUse this procedure only for a cooled, removable mirror. The [crack restriction](#crack-restriction) applies even after packing is complete.\n\n",
      "version_binding": "unversioned",
      "content_sha256": "91c3773a8fc9e1f5a3211fb25290d38ab36fed44921e5d1e01da64adeb06428f",
      "project_identity": "local:2085e4d8de8a2ba87264a14e78f55a203b96516a8e22907b434946b684aa1685",
      "line_start": 5,
      "line_end": 8,
