        "evidence_id": "ev-3d5d881404e3a050e08c4cff",
        "path_or_url": "storage.md",
        "section": "Journal storage",
        "snippet": "# Journal storage\n\nJournal files contain original live observations. Exported bundles are derived products, not journal replacements until their checksums have been verified.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "da154d110d21c1208f174b6bb1579e0aa3d8d5a43f54f194c61d57d85d16fd91",
