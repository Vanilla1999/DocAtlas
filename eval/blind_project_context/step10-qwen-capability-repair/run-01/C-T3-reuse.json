      },
      {
        "evidence_id": "ev-1136d5f5dae7cd59acce5d1b",
        "path_or_url": "storage.md",
        "section": "Journal storage > Capacity",
        "snippet": "## Capacity\n\nThe capacity monitor reports filesystem free space every minute. A low-space alert pauses new survey imports; it does not shorten journal retention or remove a legal hold.\n\n",
        "version_binding": "unversioned",
        "content_sha256": "076470003ca083aa4f2415052e6885a587d1a7b72a646d3d3293657497a36681",
        "project_identity": "local:ca33a47fbde9c15c570b9ba79ff10b2561882b96a090c3931d17a8e115ac811d",
        "line_start": 9,
