+_COMPOUND_INTERROGATIVE_RE = re.compile(
+    r"\b(?:which|what|how|when)\b.+?\b(?:and|or)\s+(?:which|what|how|when)\b",
+    re.I,
+)
+_LIST_RE = re.compile(
+    r"\b([A-Za-z][A-Za-z0-9_-]*(?:\s*,\s*[A-Za-z][A-Za-z0-9_-]*)+"
+    r"\s*,?\s*(?:and|or)\s+[A-Za-z][A-Za-z0-9_-]*)\b",
+    re.I,
+)
